# Образец: TLS и отдача наружу. Сам сервис слушает только 127.0.0.1:8000.
# Сертификат проще всего получить certbot'ом: certbot --nginx -d pump.example.com

server {
    listen 80;
    server_name pump.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name pump.example.com;

    ssl_certificate     /etc/letsencrypt/live/pump.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pump.example.com/privkey.pem;

    # Сессионная cookie ходит только по https, поэтому HSTS обязателен:
    # без него первый заход по http утечёт открытым.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    # Перебор пароля упирается ещё и в сервис (5 попыток), но дешевле
    # отбивать его здесь.
    location = /api/login {
        limit_req zone=pplogin burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        # Клиентский X-Forwarded-For затираем: сервис считает по нему попытки входа.
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Страница опрашивает /api/* фоном и держит keep-alive.
        proxy_read_timeout 75s;
    }
}

# В http-секцию (/etc/nginx/nginx.conf):
# limit_req_zone $binary_remote_addr zone=pplogin:1m rate=10r/m;
